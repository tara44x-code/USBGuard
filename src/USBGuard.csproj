<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>USBGuard</AssemblyName>
    <RootNamespace>USBGuard</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>

    <!-- رقم الاصدار: غيّره هنا وارفع للكيت هوب = يطلع تحديث جديد تلقائياً -->
    <Version>1.4.1</Version>

    <Product>USB Guard</Product>
    <AssemblyTitle>USB Guard</AssemblyTitle>
    <Company>Muhannad Sat Link</Company>
    <Authors>Muhannad Sat Link</Authors>
    <Description>USB Guard - USB flash drive protection (Autorun / Shortcut / gamez / Sality)</Description>
    <Copyright>© 2026 Muhannad Sat Link</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Management" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon.ico" LogicalName="USBGuard.icon.ico" />
    <EmbeddedResource Include="logo.png" LogicalName="USBGuard.logo.png" />
    <EmbeddedResource Include="mascot.png" LogicalName="USBGuard.mascot.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
